# Your Claude API key. You can also set this from inside the app
# (the gear icon in the page header), which takes precedence over this file.
# Get one at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Both default to claude-opus-5-5.
# claude-sonnet-5-5 is cheaper; claude-haiku-5-5 is cheaper still.
# CLAUDE_CHAT_MODEL=claude-sonnet-5-5
# CLAUDE_EDITOR_MODEL=claude-sonnet-5-5

# Optional. Where the notes and uploads live.
# NOTION_MOCK_DB=data/notion.db
# NOTION_MOCK_UPLOADS=data/uploads
